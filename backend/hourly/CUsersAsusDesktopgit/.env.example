# Hourly Backend Configuration (Firebase + NestJS)

# Server Port
PORT=4000

# Environment
NODE_ENV=development

# Firebase Admin Configuration
# Option 1: Path to Firebase Service Account JSON file (downloaded from Firebase Console -> Project Settings -> Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Individual Firebase environment credentials (useful for cloud deploys like Render, Railway, Heroku)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT Authentication Secret & Expiration
JWT_SECRET=hourly-jwt-development-secret-key-2026-super-secure
JWT_EXPIRES_IN=7d
