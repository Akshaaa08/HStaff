# HStaff Frontend Environment Variables
# Copy this file to .env and insert your actual private keys.
# NEVER commit your .env file to GitHub or any public version control!

# Backend Base URL (defaults to http://10.0.2.2:3000 on Android emulator)
REACT_APP_API_BASE_URL=http://10.0.2.2:3000

# Razorpay Test Mode Key Id (Format: rzp_test_xxxxxxxxxxxxxx)
# Procure from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=

# Google Cloud Translation API Key
# Procure from: https://console.cloud.google.com/
GOOGLE_TRANSLATE_API_KEY=
