NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://hstaff:hstaff@localhost:5432/hstaff
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
OTP_PROVIDER=console            # console | firebase | msg91  (only console is implemented, see docs/decisions.md D-12)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KYC_BUCKET=kyc-documents
SUPABASE_PUBLIC_BUCKET=profile-photos
ORS_API_KEY=
NOMINATIM_USER_AGENT=hstaff-dev (you@example.com)
GEOFENCE_RADIUS_M=150
COMMISSION_PCT=15
REQUEST_TTL_MIN=10
APPROVAL_SLA_HOURS=24
PAYMENT_PROVIDER=simulated      # simulated | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CORS_ORIGINS=http://localhost:5173

# --- Additions beyond the TRD list (see docs/decisions.md D-02, D-03) ---
# Public base URL of this API; only used to build signed URLs for the local-disk storage fallback.
API_PUBLIC_URL=http://localhost:4000
# Used only by `npm run seed`. Required when NODE_ENV=production, defaults to Admin@12345 otherwise.
